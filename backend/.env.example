PORT=3001
NODE_ENV=development
APP_VERSION=dev

# Database
DB_TYPE=sqlite
DB_DATABASE=database.sqlite

# Redis & BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_here
BACKEND_PUBLIC_URL=http://localhost:3001

# Initial admin bootstrap
# Optional: only used when the admin table is empty.
# Set both values once to create the first superadmin, then remove them.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# File Storage (MinIO / S3)
# Supports full URL like http://127.0.0.1:9000 or hostname only.
S3_ENDPOINT=http://127.0.0.1:9000
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=phantomdraw

# AI Model Provider
# SD API URL or OpenAI compatible endpoint
AI_API_URL=http://localhost:7860
AI_API_KEY=your_ai_api_key_here
