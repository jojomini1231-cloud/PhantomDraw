APP_VERSION=dev

# Backend runtime
DB_DATABASE=/app/data/database.sqlite
BACKEND_PUBLIC_URL=http://localhost:3008
CORS_ORIGIN=https://phantomdraw.jojoz.cn,http://localhost:3000,http://localhost:4322
JWT_SECRET=replace-with-a-long-random-string
ADMIN_JWT_SECRET=replace-with-another-long-random-string
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Frontend public URLs (used at image build time and runtime)
NEXT_PUBLIC_API_URL=http://localhost:3008/api
NEXT_PUBLIC_WS_URL=ws://localhost:3008

# Object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
S3_ENDPOINT=http://minio:9000
S3_PORT=9000
S3_USE_SSL=false
S3_BUCKET=phantomdraw

# Optional monitoring credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-password
